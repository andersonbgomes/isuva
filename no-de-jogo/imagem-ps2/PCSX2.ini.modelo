; ============================================================================
; A configuração do PCSX2 dentro do contentor (ver arrancar-pcsx2.sh).
; @BIOS@ é trocado pelo nome do ficheiro da BIOS da sessão.
;
; OS COMANDOS são o que mais provavelmente precisa de afinação no primeiro
; teste: o teclado chega pelo X (Selkies), e o gamepad do browser aparece
; ao PCSX2 como um comando SDL (SDL-0). Cada botão tem as duas ligações --
; uma linha por ligação, que é como o PCSX2 guarda listas.
; ============================================================================

[UI]
SettingsVersion = 1
SetupWizardIncomplete = false
ConfirmShutdown = false
StartFullscreen = true
HideMouseCursor = true
RenderToSeparateWindow = false
InhibitScreensaver = true

[Folders]
Bios = /bios
MemoryCards = /cartoes

[Filenames]
BIOS = @BIOS@

[EmuCore]
EnableFastBoot = true

[EmuCore/GS]
; 12 = OpenGL (com o vglrun, na placa NVIDIA)
Renderer = 12
; 2x a resolução nativa: 720p-ish, o que o streaming a 1280x720 aguenta
upscale_multiplier = 2
VsyncEnable = 0

[MemoryCards]
Slot1_Enable = true
Slot1_Filename = Mcd001.ps2
Slot2_Enable = false

[InputSources]
Keyboard = true
SDL = true

[Pad1]
Type = DualShock2
Up = Keyboard/Up
Up = SDL-0/DPadUp
Right = Keyboard/Right
Right = SDL-0/DPadRight
Down = Keyboard/Down
Down = SDL-0/DPadDown
Left = Keyboard/Left
Left = SDL-0/DPadLeft
Triangle = Keyboard/I
Triangle = SDL-0/FaceNorth
Circle = Keyboard/L
Circle = SDL-0/FaceEast
Cross = Keyboard/K
Cross = SDL-0/FaceSouth
Square = Keyboard/J
Square = SDL-0/FaceWest
Select = Keyboard/Backspace
Select = SDL-0/Back
Start = Keyboard/Return
Start = SDL-0/Start
L1 = Keyboard/Q
L1 = SDL-0/LeftShoulder
L2 = Keyboard/1
L2 = SDL-0/+LeftTrigger
R1 = Keyboard/E
R1 = SDL-0/RightShoulder
R2 = Keyboard/3
R2 = SDL-0/+RightTrigger
L3 = Keyboard/2
L3 = SDL-0/LeftStick
R3 = Keyboard/4
R3 = SDL-0/RightStick
LUp = Keyboard/W
LUp = SDL-0/-LeftY
LRight = Keyboard/D
LRight = SDL-0/+LeftX
LDown = Keyboard/S
LDown = SDL-0/+LeftY
LLeft = Keyboard/A
LLeft = SDL-0/-LeftX
RUp = SDL-0/-RightY
RRight = SDL-0/+RightX
RDown = SDL-0/+RightY
RLeft = SDL-0/-RightX
