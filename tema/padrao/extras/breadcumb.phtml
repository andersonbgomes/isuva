?>
	<div class="miolo-topo">
		<h1><?=esc(titulo())?></h1>
		<div class="miolo-botoes">
			<?php
			switch (rota) {
				case 'jogos':
					?><a class="btn btn-claro" href="<?=url_base('jogar/local')?>">Jogar do meu computador</a><?php
					if($this->e_admin()){
						?><a class="btn" href="<?=url_base('admin/novo')?>">Adicionar jogo</a><?php
					}
					break;

				case 'utilizadores':
					if(acao !== 'index'){
						?><a class="btn btn-claro" href="<?=url_base('utilizadores')?>">Voltar à lista</a><?php
					} else {
						?><a class="btn btn-claro" href="<?=url_base('utilizadores/google')?>">Entrar com o Google</a><?php
						?><a class="btn" href="<?=url_base('utilizadores/novo')?>"><?=icone('mais')?> Nova conta</a><?php
					}
					break;

				case 'servidores':
					if(acao !== 'index'){
						?><a class="btn btn-claro" href="<?=url_base('servidores')?>">Voltar à lista</a><?php
					} else {
						?><a class="btn" href="<?=url_base('servidores/novo')?>">Acrescentar servidor</a><?php
					}
					break;

				case 'admin':
					if(acao !== 'index'){
						?><a class="btn btn-claro" href="<?=url_base('admin')?>">Voltar à lista</a><?php
					}
					if(acao !== 'emulador'){
						?><a class="btn btn-claro" href="<?=url_base('admin/emulador')?>">Emulador e BIOS</a><?php
					}
					if(acao !== 'novo'){
						?><a class="btn" href="<?=url_base('admin/novo')?>">Adicionar jogo</a><?php
					}
					break;
			}
			?>
		</div>
	</div>
