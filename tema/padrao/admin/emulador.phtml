<script src="<?=url_versionada('tema/padrao/ext/assets/js/envio.js')?>"></script>
<script>
/*
A BIOS vai aos pedaços, como os jogos: a da PS2 (4 MB) não passa num
servidor com upload_max_filesize de 2 MB. O ficheiro deixa de ir no
formulário (o input perde o name) e o formulário só leva o "envio".
*/
document.querySelectorAll('.form-bios').forEach(function (form) {
	form.addEventListener('submit', async function (e) {
		var input = form.querySelector('input[type=file]');
		var botao = form.querySelector('button');
		if (form.dataset.pronto === '1' || !input.files[0]) { return; }
		e.preventDefault();

		botao.disabled = true;
		try {
			var id = await enviarAosPedacos({
				ficheiro:  input.files[0],
				campos:    { consola: form.consola.value, tipo: 'bios' },
				csrf:      form.csrf_token.value,
				iniciar:   <?=json_encode(url_base('admin/iniciar'), JSON_HEX_TAG | JSON_UNESCAPED_SLASHES)?>,
				pedaco:    <?=json_encode(url_base('admin/pedaco'), JSON_HEX_TAG | JSON_UNESCAPED_SLASHES)?>,
				progresso: function (pct) { botao.textContent = pct + '%'; }
			});
			form.envio.value = id;
			input.removeAttribute('name');
			form.dataset.pronto = '1';
			form.submit();
		} catch (erro) {
			alert(erro.message);
			botao.disabled = false;
			botao.textContent = 'Enviar';
		}
	});
});
</script>
