<?php
/*
O catálogo: uma grelha de capas, com filtro por consola e pesquisa.

O filtro é um formulário GET (não altera nada), por isso não leva CSRF.
*/
$consolaActual = $this->ver->consola;
?>
<form class="filtros" method="get" action="<?=url_base('jogos')?>">
	<select name="consola" onchange="this.form.submit()" aria-label="Consola">
		<option value="">Todas as consolas</option>
		<?php foreach (Consolas::porFamilia() as $familia => $lista): ?>
		<optgroup label="<?=esc($familia)?>">
			<?php foreach ($lista as $chave => $c): ?>
			<option value="<?=esc($chave)?>" <?=$chave === $consolaActual ? 'selected' : ''?>><?=esc($c['nome'])?></option>
			<?php endforeach; ?>
		</optgroup>
		<?php endforeach; ?>
	</select>
	<input type="text" name="q" value="<?=esc($this->ver->pesquisa)?>" placeholder="Procurar pelo título" maxlength="100">
	<button type="submit" class="btn">Procurar</button>
</form>

<?php if(empty($this->ver->jogos)): ?>
<div class="cartao texto-centro">
	<h2>Nenhum jogo por aqui</h2>
	<p class="texto-fraco">
		<?php if($consolaActual !== '' || $this->ver->pesquisa !== ''): ?>
			Nenhum jogo corresponde ao filtro. <a href="<?=url_base('jogos')?>">Ver todos</a>.
		<?php else: ?>
			O catálogo ainda está vazio.
		<?php endif; ?>
		Também pode <a href="<?=url_base('jogar/local')?>">jogar um ficheiro do seu computador</a>.
	</p>
</div>
<?php else: ?>
<div class="grelha-jogos">
	<?php foreach ($this->ver->jogos as $j): ?>
	<a class="jogo" href="<?=url_base('jogar/ver/'.(int)$j['id_jg'])?>">
		<div class="jogo-capa">
			<?php if(!empty($j['capa_jg'])): ?>
			<img src="<?=url_base('jogar/capa/'.(int)$j['id_jg'])?>" alt="" loading="lazy">
			<?php else: ?>
			<span><?=esc(mb_substr($j['titulo_jg'], 0, 1))?></span>
			<?php endif; ?>
		</div>
		<div class="jogo-info">
			<strong><?=esc($j['titulo_jg'])?></strong>
			<small><?=esc(Consolas::nome($j['consola_jg']))?></small>
			<?php if(Consolas::noServidor($j['consola_jg'])): ?><span class="etiqueta">No servidor</span><?php endif; ?>
		</div>
	</a>
	<?php endforeach; ?>
</div>
<?php endif; ?>
