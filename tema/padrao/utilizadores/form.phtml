?>
<form class="cartao" method="post" action="<?=$accao?>" style="max-width:640px" autocomplete="off">
	<?=csrf_field()?>

	<label for="nome">Nome</label>
	<input type="text" id="nome" name="nome" required maxlength="150" value="<?=esc($c['nome_us'])?>">

	<label for="email">E-mail</label>
	<input type="email" id="email" name="email" required maxlength="190" value="<?=esc($c['email_us'])?>">
	<p class="ajuda">É com este e-mail que a pessoa entra.</p>

	<label for="senha">Palavra-passe <?php if(!$novo): ?><span class="texto-fraco">(deixe em branco para não mudar)</span><?php endif; ?></label>
	<input type="password" id="senha" name="senha" <?=$novo ? 'required' : ''?> minlength="8" autocomplete="new-password">
	<p class="ajuda">Pelo menos 8 caracteres.</p>

	<label><input type="checkbox" name="activa" value="1" <?=(int)$c['stto_us'] === 1 ? 'checked' : ''?>> Conta activa (pode entrar)</label>
	<label><input type="checkbox" name="admin" value="1" <?=(int)$c['nivl_us'] === 1 ? 'checked' : ''?>> Administrador (gere jogos, servidores e contas)</label>

	<button type="submit" class="btn btn-largo"><?=$novo ? 'Criar conta' : 'Gravar'?></button>
