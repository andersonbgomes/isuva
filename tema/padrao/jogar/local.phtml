<?php
/*
JOGAR UM FICHEIRO DO COMPUTADOR DE QUEM JOGA.

O ficheiro escolhido NUNCA sai do computador: o JavaScript entrega o
objecto File directamente ao EmulatorJS (EJS_gameUrl aceita um File), e
o browser lê-o do disco. Nada vai para o servidor.

O emulador só arranca uma vez por página -- o EmulatorJS não foi feito
para trocar de núcleo sem recarregar. Para jogar outro, recarrega-se.
*/
$JSON = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
?>
<!DOCTYPE html>
<html lang="pt">
<head>
	<?=head()?>
	<meta name="theme-color" content="#18181b">
	<link rel="stylesheet" href="<?=url_versionada('tema/padrao/ext/assets/css/estilo.css')?>">
</head>
<body class="palco">

<header class="palco-topo">
	<a class="btn btn-escuro" href="<?=url_base('jogos')?>"><?=icone('voltar')?> Jogos</a>
	<div class="palco-titulo">
		<strong>Jogar do meu computador</strong>
		<small>O ficheiro não é enviado para o servidor</small>
	</div>
</header>

<div class="palco-aviso" id="aviso" hidden></div>

<form class="palco-escolha" id="escolha">
	<label for="consola">Consola</label>
	<select id="consola" required>
		<option value="">Escolha a consola</option>
		<?php foreach (Consolas::porFamilia('browser') as $familia => $lista): ?>
		<optgroup label="<?=esc($familia)?>">
			<?php foreach ($lista as $chave => $c): ?>
			<option value="<?=esc($chave)?>"><?=esc($c['nome'])?></option>
			<?php endforeach; ?>
		</optgroup>
		<?php endforeach; ?>
	</select>
	<p class="palco-nota" id="nota"></p>

	<label for="ficheiro">Ficheiro do jogo</label>
	<input type="file" id="ficheiro" required>

	<button type="submit" class="btn btn-largo">Jogar</button>
	<p class="palco-nota">
		Num jogo do seu computador, as gravações ficam só neste browser. Para as ter na sua conta
		(e continuar noutro computador), jogue a partir do catálogo.
	</p>
</form>

<main class="palco-ecra" id="ecra" hidden>
	<div id="jogo"></div>
</main>

<script>
(function () {
	var CONSOLAS = <?=json_encode($this->ver->consolas, $JSON)?>;
	var form = document.getElementById('escolha');
	var sel  = document.getElementById('consola');
	var fich = document.getElementById('ficheiro');
	var nota = document.getElementById('nota');
	var aviso = document.getElementById('aviso');

	function avisar(texto) { aviso.textContent = texto; aviso.hidden = !texto; }

	sel.addEventListener('change', function () {
		var c = CONSOLAS[sel.value];
		avisar('');
		if (!c) { nota.textContent = ''; fich.removeAttribute('accept'); return; }

		nota.textContent = c.nota + ' Formatos: ' + c.ext.map(function (e) { return '.' + e; }).join(' ');
		fich.setAttribute('accept', c.ext.map(function (e) { return '.' + e; }).join(','));

		if (c.pedeConta) {
			avisar('Esta consola precisa de uma conta (por causa da BIOS). Entre ou crie uma conta, é grátis.');
		} else if (c.semBios) {
			avisar('Esta consola precisa de uma BIOS, e o administrador ainda não a enviou. O jogo não vai arrancar.');
		} else if (c.threads && !window.crossOriginIsolated) {
			avisar('Este browser não permite correr esta consola (falta-lhe suporte a threads). Experimente o Chrome, o Edge ou o Firefox, actualizados.');
		}
	});

	form.addEventListener('submit', function (e) {
		e.preventDefault();
		var c = CONSOLAS[sel.value], f = fich.files[0];
		if (!c || !f) { return; }

		if (c.pedeConta) {
			avisar('Esta consola precisa de uma conta (por causa da BIOS). Entre ou crie uma conta, é grátis.');
			return;
		}

		//a mesma regra do servidor: é pela extensão que o emulador escolhe o que arrancar
		var ext = f.name.split('.').pop().toLowerCase();
		if (c.ext.indexOf(ext) === -1) {
			avisar('Um ficheiro .' + ext + ' não serve para ' + c.nome + '. Formatos aceites: ' + c.ext.join(', ') + '.');
			return;
		}

		//um aviso de uma tentativa anterior (extensão errada) já não se aplica;
		//o da BIOS em falta e o das threads continuam a valer, e ficam
		if (!c.semBios && !(c.threads && !window.crossOriginIsolated)) { avisar(''); }

		form.hidden = true;
		document.getElementById('ecra').hidden = false;

		window.EJS_player     = '#jogo';
		window.EJS_core       = c.core;
		window.EJS_pathtodata = c.pathtodata;
		window.EJS_gameUrl    = f;
		//o nome sem a extensão: é por ele que as gravações deste jogo ficam guardadas no browser
		window.EJS_gameName   = f.name.replace(/\.[^.]+$/, '');
		window.EJS_language   = 'pt-BR';
		window.EJS_color      = '#14b8a6';
		if (c.biosUrl) { window.EJS_biosUrl = c.biosUrl; }
		if (c.threads) { window.EJS_threads = true; }

		var s = document.createElement('script');
		s.src = c.pathtodata + 'loader.js';
		s.onerror = function () { avisar('Não foi possível carregar o emulador. Verifique a ligação à internet.'); };
		document.body.appendChild(s);
	});
})();
</script>
</body>
</html>
