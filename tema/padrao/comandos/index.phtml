<script src="<?=url_versionada('tema/padrao/ext/assets/js/comandos.js')?>"></script>
<script>
(function () {
	var C = window.IsuvaComandos;
	var el = function (id) { return document.getElementById(id); };
	var escolhido = null;   //o índice do comando que se está a ver
	var nomesBotoes = ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Share', 'Options', 'L3', 'R3', '▲', '▼', '◀', '▶', 'PS', 'touchpad'];

	if (!window.isSecureContext) { el('sem-https').hidden = false; }

	function desenharEscolha(pads) {
		var caixa = el('escolha');
		var chave = pads.map(function (p) { return p.index + p.id; }).join('|');
		if (caixa.dataset.chave === chave) { return; }
		caixa.dataset.chave = chave;
		caixa.innerHTML = '';
		if (pads.length < 2) { return; }
		pads.forEach(function (p) {
			var b = document.createElement('button');
			b.type = 'button';
			b.className = 'btn ' + (p.index === escolhido ? '' : 'btn-claro');
			b.textContent = (p.index + 1) + '. ' + C.nome(p);
			b.addEventListener('click', function () { escolhido = p.index; caixa.dataset.chave = ''; });
			caixa.appendChild(b);
		});
	}

	function ciclo() {
		var pads = C.lista();
		el('sem-comando').hidden = pads.length > 0;
		el('com-comando').hidden = pads.length === 0;

		if (pads.length) {
			var g = pads.filter(function (p) { return p.index === escolhido; })[0] || pads[0];
			escolhido = g.index;
			desenharEscolha(pads);

			el('pad-nome').textContent = C.nome(g);
			el('pad-mapa').textContent = g.mapping === 'standard' ? 'padrão (standard)' : 'não padrão';
			el('pad-nao-standard').hidden = g.mapping === 'standard';
			el('pad-botoes').textContent = g.buttons.length;
			el('pad-eixos').textContent = g.axes.length;
			el('pad-id').textContent = g.id;

			document.querySelectorAll('#desenho [data-b]').forEach(function (d) {
				var b = g.buttons[+d.dataset.b];
				var premido = !!(b && (b.pressed || b.value > 0.15));
				d.classList.toggle('on', premido);
				if (premido) { el('pad-ultimo').textContent = nomesBotoes[+d.dataset.b] || ('botão ' + d.dataset.b); }

				//os gatilhos (L2/R2) são analógicos: a barra enche com a pressão
				var gat = d.querySelector('.gatilho');
				if (gat) { gat.style.width = Math.round((b ? b.value : 0) * 100) + '%'; }

				//os analógicos: a bolinha mexe com os dois eixos
				if (d.dataset.eixos) {
					var e = d.dataset.eixos.split(',');
					var x = g.axes[+e[0]] || 0, y = g.axes[+e[1]] || 0;
					d.querySelector('i').style.transform = 'translate(calc(-50% + ' + (x * 60) + '%), calc(-50% + ' + (y * 60) + '%))';
					if (Math.abs(x) > 0.2 || Math.abs(y) > 0.2) { d.classList.add('on'); }
				}
			});
		}
		requestAnimationFrame(ciclo);
	}
	requestAnimationFrame(ciclo);

	/*
	A vibração: só alguns browsers a dão (Chrome e Edge sim; Firefox e
	Safari, por agora, não). Quando não há, diz-se -- e não é sinal de que
	o comando tem defeito.
	*/
	el('vibrar').addEventListener('click', function () {
		var g = C.lista().filter(function (p) { return p.index === escolhido; })[0];
		var msg = el('vibrar-msg');
		if (g && g.vibrationActuator && g.vibrationActuator.playEffect) {
			g.vibrationActuator.playEffect('dual-rumble', { duration: 600, strongMagnitude: 1, weakMagnitude: 0.6 })
				.then(function () { msg.textContent = 'Vibrou? Se sim, está tudo bem.'; })
				.catch(function () { msg.textContent = 'Este comando não aceitou a vibração.'; });
		} else {
			msg.textContent = 'Este browser não faz vibrar comandos (o Chrome e o Edge fazem). Não é defeito do comando.';
		}
	});
})();
</script>
