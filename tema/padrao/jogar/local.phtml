	</div>

	<button type="submit" class="btn btn-largo" id="jogar">Jogar</button>
	<p class="palco-nota">
		Num jogo do seu computador ou de um link, as gravações ficam só neste browser. Para as ter na sua
		conta (e continuar noutro computador), jogue a partir do catálogo.
	</p>
</form>

<main class="palco-ecra" id="ecra" hidden>
	<div id="jogo"></div>
</main>

<script>
(function () {
	var CONSOLAS = <?=json_encode($this->ver->consolas, $JSON)?>;
	var URL_SUGERIR = <?=json_encode(url_base('sugestoes'), $JSON)?>;
	var form = document.getElementById('escolha');
	var sel  = document.getElementById('consola');
	var fich = document.getElementById('ficheiro');
	var link = document.getElementById('link');
	var nota = document.getElementById('nota');
	var aviso = document.getElementById('aviso');
	var barra = document.getElementById('progresso');
	var botao = document.getElementById('jogar');

	function avisar(texto) { aviso.textContent = texto; aviso.hidden = !texto; }
	function origem() { return form.querySelector('[name=origem]:checked').value; }

	form.querySelectorAll('[name=origem]').forEach(function (r) {
		r.addEventListener('change', function () {
			document.getElementById('por-ficheiro').hidden = origem() !== 'ficheiro';
			document.getElementById('por-link').hidden = origem() !== 'link';
		});
	});

	sel.addEventListener('change', function () {
		var c = CONSOLAS[sel.value];
		avisar('');
		if (!c) { nota.textContent = ''; fich.removeAttribute('accept'); return; }

		nota.textContent = c.nota + ' Formatos: ' + c.ext.map(function (e) { return '.' + e; }).join(' ');
		fich.setAttribute('accept', c.ext.map(function (e) { return '.' + e; }).join(','));

		if (c.pedeConta) {
			avisar('Esta consola precisa de uma conta (por causa da BIOS). Entre ou crie uma conta, é grátis.');
		} else if (c.semBios) {
			avisar('Esta consola precisa de uma BIOS, e o administrador ainda não a enviou. O jogo não vai arrancar.');
		} else if (c.threads && !window.crossOriginIsolated) {
			avisar('Este browser não permite correr esta consola (falta-lhe suporte a threads). Experimente o Chrome, o Edge ou o Firefox, actualizados.');
		}
	});

	//o nome do ficheiro no fim do endereço ("…/Jogo%20Bom.nes?x=1" -> "Jogo Bom.nes")
	function nomeDoLink(endereco) {
		try {
			return decodeURIComponent(new URL(endereco).pathname.split('/').pop()) || '';
		} catch (e) { return ''; }
	}

	function extensao(nome) {
		return nome.indexOf('.') !== -1 ? nome.split('.').pop().toLowerCase() : '';
	}

	function naoServe(ext, c) {
		return (ext ? 'Um ficheiro .' + ext : 'Um ficheiro sem extensão') + ' não serve para ' + c.nome
			+ '. Formatos aceites: ' + c.ext.join(', ') + '.';
	}

	/*
	Descarrega o link no browser, com a percentagem, e devolve um File --
	o mesmo tipo de objecto que o "do meu computador" dá ao emulador.
	*/
	async function descarregar(endereco) {
		var r;
		try {
			r = await fetch(endereco, { credentials: 'omit', referrerPolicy: 'no-referrer' });
		} catch (e) {
			//o browser não diz porquê, de propósito; quase sempre é o CORS
			throw new Error('O site desse link não deixa outros sites abrirem os ficheiros dele (é uma regra do browser, o CORS). '
				+ 'Pode descarregar o ficheiro e escolher "Do meu computador", ou sugerir o jogo ao catálogo: aí quem o descarrega é o nosso servidor.');
		}
		if (!r.ok) {
			throw new Error('O site do link respondeu ' + r.status + '. Confirme que o link descarrega o ficheiro directamente.');
		}
		if (/text\/html/i.test(r.headers.get('Content-Type') || '')) {
			throw new Error('Esse link abre uma página, e não o ficheiro do jogo. Precisa do link de descarga directa.');
		}

		var total = parseInt(r.headers.get('Content-Length') || '0', 10);
		var partes = [], recebido = 0;
		barra.hidden = false;
		if (r.body && r.body.getReader) {
			var leitor = r.body.getReader();
			for (;;) {
				var p = await leitor.read();
				if (p.done) { break; }
				partes.push(p.value);
				recebido += p.value.length;
				var pct = total ? Math.min(100, Math.round(recebido / total * 100)) : 0;
				barra.firstElementChild.style.width = (total ? pct : 50) + '%';
				botao.textContent = 'A descarregar... ' + (total ? pct + '%' : (recebido / 1048576).toFixed(1) + ' MB');
			}
		} else {
			partes.push(await r.blob());
		}

		//um redireccionamento pode ter levado a um endereço com o nome verdadeiro
		var nome = nomeDoLink(r.url);
		if (!extensao(nome)) { nome = nomeDoLink(endereco); }
		return new File(partes, nome || 'jogo');
	}

	/*
	Um jogo de um link pode ir para o catálogo: o botão leva às sugestões
	com o link e a consola já escritos (é lá que se pede a conta).
	*/
	function mostrarSugerir(endereco) {
		var a = document.getElementById('sugerir');
		a.href = URL_SUGERIR + '?' + new URLSearchParams({
			link: endereco,
			consola: sel.value,
			titulo: nomeDoLink(endereco).replace(/\.[^.]+$/, '')
		}).toString();
		a.hidden = false;
	}

	function reporBotao() {
		botao.disabled = false;
		botao.textContent = 'Jogar';
		barra.hidden = true;
	}

	form.addEventListener('submit', async function (e) {
		e.preventDefault();
		if (botao.disabled) { return; }
		var c = CONSOLAS[sel.value];
		if (!c) { avisar('Escolha a consola.'); return; }

		if (c.pedeConta) {
			avisar('Esta consola precisa de uma conta (por causa da BIOS). Entre ou crie uma conta, é grátis.');
			return;
		}

		var f = fich.files[0], endereco = '';
		if (origem() === 'link') {
			endereco = link.value.trim();
			if (!/^https?:\/\//i.test(endereco)) {
				avisar('O link tem de começar por http:// ou https://.');
				return;
			}
			//uma página https não pode ler um http:// (o browser bloqueia, sem dizer porquê)
			if (location.protocol === 'https:' && /^http:\/\//i.test(endereco)) {
				avisar('O browser não deixa abrir um link http:// a partir de um site seguro. Use um link https://.');
				return;
			}
			//se o link já mostra a extensão, vê-se antes de descarregar tudo
			var antes = extensao(nomeDoLink(endereco));
			if (antes && c.ext.indexOf(antes) === -1) {
				avisar(naoServe(antes, c));
				return;
			}

			botao.disabled = true;
			avisar('');
			try {
				f = await descarregar(endereco);
			} catch (erro) {
				avisar(erro.message);
				reporBotao();
				mostrarSugerir(endereco);
				return;
			}
		} else if (!f) {
			avisar('Escolha o ficheiro do jogo.');
			return;
		}

		//a mesma regra do servidor: é pela extensão que o emulador escolhe o que arrancar
		var ext = extensao(f.name);
		if (c.ext.indexOf(ext) === -1) {
			avisar(naoServe(ext, c));
			reporBotao();
			return;
		}
		if (endereco) { mostrarSugerir(endereco); }

		//um aviso de uma tentativa anterior (extensão errada) já não se aplica;
		//o da BIOS em falta e o das threads continuam a valer, e ficam
		if (!c.semBios && !(c.threads && !window.crossOriginIsolated)) { avisar(''); }

		form.hidden = true;
		document.getElementById('ecra').hidden = false;

		window.EJS_player     = '#jogo';
		window.EJS_core       = c.core;
		window.EJS_pathtodata = c.pathtodata;
		window.EJS_gameUrl    = f;
		//o nome sem a extensão: é por ele que as gravações deste jogo ficam guardadas no browser
		window.EJS_gameName   = f.name.replace(/\.[^.]+$/, '');
		window.EJS_language   = 'pt-BR';
		window.EJS_color      = '#14b8a6';
		if (c.biosUrl) { window.EJS_biosUrl = c.biosUrl; }
		if (c.threads) { window.EJS_threads = true; }

		var s = document.createElement('script');
		s.src = c.pathtodata + 'loader.js';
		s.onerror = function () { avisar('Não foi possível carregar o emulador. Verifique a ligação à internet.'); };
		document.body.appendChild(s);
	});
})();
</script>
</body>
</html>
